---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
  return chapters.map((entry: CollectionEntry<'chapters'>, index: number) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: chapters[index - 1],
      next: chapters[index + 1],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings} prev={prev} next={next} chapters={chapters}>
  <Content />
</ArticleLayout>
