---
import { SITE, SERIES } from '../consts';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="seal" aria-hidden="true">AS</span>
        <div>
          <strong>{SITE.name} · {SITE.blogTitle}</strong>
          <span>{SITE.blogSubtitle} · 持续更新</span>
        </div>
      </div>
      <div class="footer-links">
        <a href={SITE.base + '/'}>文章集</a>
        <a href={SITE.base + '/ai-evolution/'}>从对话到协作</a>
        <a href={SITE.base + '/about/'}>关于</a>
        <a href={SITE.base + '/rss.xml'}>RSS</a>
        <a href={SITE.personalSite}>个人主页 ↗</a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 {SITE.name}</span>
      <span>文字以 {SERIES.license} 授权 · 转载注明出处</span>
      <span>用 Astro 构建 · GitHub Pages</span>
    </div>
  </div>
</footer>