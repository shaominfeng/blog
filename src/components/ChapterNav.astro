---
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../consts';

interface Props {
  chapters: CollectionEntry<'chapters'>[];
  currentId?: string;
}

const { chapters, currentId } = Astro.props;
const sorted = [...chapters].sort((a, b) => a.data.order - b.data.order);

const groups: { part: string; items: CollectionEntry<'chapters'>[] }[] = [];
for (const chapter of sorted) {
  const last = groups[groups.length - 1];
  if (!last || last.part !== chapter.data.part) {
    groups.push({ part: chapter.data.part, items: [chapter] });
  } else {
    last.items.push(chapter);
  }
}
---

<nav class="side-nav" aria-label="章节目录">
  <a class="side-brand" href={SITE.base + '/'}>
    从对话到协作
    <small>{SITE.chapterCount} 章 · {SITE.start}—{SITE.end}</small>
  </a>
  {groups.map((group) => (
    <div class="side-part">
      <span class="side-part-label">{group.part} / {String(group.items.length).padStart(2, '0')}</span>
      {group.items.map((chapter) => (
        <a
          href={SITE.base + '/read/' + chapter.id + '/'}
          class={chapter.id === currentId ? 'active' : undefined}
          aria-current={chapter.id === currentId ? 'page' : undefined}
        >
          <span class="side-num">{String(chapter.data.num).padStart(2, '0')}</span>
          {chapter.data.title}
        </a>
      ))}
    </div>
  ))}
</nav>
