---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title="页面不存在" description="这个页面不存在，回到写作首页继续阅读。" noindex>
  <div class="shell notfound">
    <span class="code">404</span>
    <h1>这一页还没有被写下来</h1>
    <p>链接可能已经移动，或者从未存在。</p>
    <a class="btn btn-primary" href={SITE.base + '/'}>回到写作 <span aria-hidden="true">→</span></a>
  </div>
</BaseLayout>
