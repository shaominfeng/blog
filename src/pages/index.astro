---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SERIES } from '../consts';

const articles = (await getCollection('articles'))
  .filter((article) => article.data.series === SERIES.slug)
  .sort((a, b) => a.data.order - b.data.order);

const totalMinutes = articles.reduce((sum, article) => sum + article.data.readingTime, 0);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name + ' · ' + SITE.blogTitle,
  description: SITE.description,
  url: new URL(SITE.base + '/', Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
    alternateName: SITE.authorEn,
    url: SITE.personalSite,
  },
  blogPost: articles.map((article) => ({
    '@type': 'BlogPosting',
    headline: article.data.title,
    url: new URL(SITE.base + '/ai-evolution/' + article.id.split('/').pop() + '/', Astro.site).toString(),
  })),
};
---

<BaseLayout title={SITE.blogTitle} description={SITE.description} structuredData={structuredData}>
  <section class="shell blog-hero">
    <p class="label">Writing / 2026</p>
    <h1>文章集</h1>
    <p class="blog-intro">
      把做过的事写清楚，是我检验自己是否真的理解的方式。
      这里放长文：技术原理、架构判断，以及从企业实践里带回来的经验。
    </p>
    <div class="blog-meta">
      <span>1 个系列</span>
      <span>{SERIES.chapterCount} 章</span>
      <span>约 {SERIES.words}字</span>
      <span>{SERIES.sources} 份参考</span>
      <a href={SITE.base + '/rss.xml'}>RSS</a>
    </div>
  </section>

  <section class="shell blog-section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">01</span>
        <h2 class="section-title">系列</h2>
      </div>
      <span class="section-note">01 series</span>
    </div>

    <a class="series-feature" href={SITE.base + '/ai-evolution/'}>
      <div class="sf-copy">
        <span class="project-index">Series 01 · {SERIES.start}—{SERIES.end} · 已完结</span>
        <h3>{SERIES.title}</h3>
        <p class="sf-sub">{SERIES.subtitle}</p>
        <p class="sf-desc">{SERIES.description}</p>
        <div class="sf-metrics">
          <span><b>{SERIES.chapterCount}</b> 章</span>
          <span><b>{SERIES.words}</b> 字</span>
          <span><b>{SERIES.sources}</b> 份参考</span>
          <span><b>{totalMinutes}</b> 分钟</span>
        </div>
        <span class="text-link">进入系列 →</span>
      </div>
      <div class="sf-cover">
        <img src={SITE.base + SERIES.cover} alt="AI 能力演进：从对话 AI 到协作 AI" width="1400" height="764" loading="eager" />
        <span>{SERIES.updated} 更新</span>
      </div>
    </a>
  </section>

  <section class="shell blog-section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">02</span>
        <h2 class="section-title">全部章节</h2>
      </div>
      <span class="section-note">{SERIES.chapterCount} chapters</span>
    </div>

    <div class="post-list">
      {articles.map((article) => (
        <a class="post-row" href={SITE.base + '/ai-evolution/' + article.id.split('/').pop() + '/'}>
          <span class="pr-num">{String(article.data.num).padStart(2, '0')}</span>
          <span class="pr-main">
            <span class="pr-title">{article.data.title}</span>
            <span class="pr-desc">{article.data.description}</span>
          </span>
          <span class="pr-meta">
            <span>{article.data.part}</span>
            <span>{article.data.readingTime} min</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell blog-about">
    <div class="about-grid">
      <div class="about-copy">
        <p class="about-statement">下一篇文章，正在写。</p>
        <p>
          这个文章集会持续更新：除了《从对话到协作》，还会加入单篇的技术笔记、架构复盘和工具实践。
          如果你有想看的主题，欢迎来信。
        </p>
        <div class="contact-line">
          <a href={'mailto:' + SITE.email}>Email</a>
          <a href={SITE.personalSite}>个人主页 ↗</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="about-mark" aria-hidden="true">
        <span class="monogram">邵</span>
        <span class="mark-label">WRITING · 2026</span>
      </div>
    </div>
  </section>
</BaseLayout>
