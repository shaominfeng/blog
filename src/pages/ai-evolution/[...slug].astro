---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SERIES } from '../../consts';

export async function getStaticPaths() {
  const articles = (await getCollection('articles'))
    .filter((article) => article.data.series === SERIES.slug)
    .sort((a, b) => a.data.order - b.data.order);

  return articles.map((entry: CollectionEntry<'articles'>, index: number) => ({
    params: { slug: entry.id.split('/').pop() },
    props: {
      entry,
      prev: articles[index - 1],
      next: articles[index + 1],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const articles = (await getCollection('articles'))
  .filter((article) => article.data.series === SERIES.slug)
  .sort((a, b) => a.data.order - b.data.order);
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings} prev={prev} next={next} articles={articles}>
  <Content />
</ArticleLayout>
