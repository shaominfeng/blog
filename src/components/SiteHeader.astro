---
import { SITE } from '../consts';

const path = Astro.url.pathname;
const isIndex = path === SITE.base + '/' || path === SITE.base;
const isEssays = path.startsWith(SITE.base + '/essays/');
const isCollection = isIndex || isEssays;
const isSeries = path.startsWith(SITE.base + '/ai-evolution/');
const isAbout = path === SITE.base + '/about/' || path === SITE.base + '/about';
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={SITE.base + '/'}>
      <span class="seal" aria-hidden="true">AS</span>
      <span class="brand-copy">
        <strong>{SITE.name} · 文章集</strong>
        <span>Writing & Notes</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <a class="nav-text" href={SITE.base + '/'} aria-current={isCollection ? 'page' : undefined}>文章集</a>
      <a class="nav-text" href={SITE.base + '/essays/'} aria-current={isEssays ? 'page' : undefined}>单篇</a>
      <a class="nav-text" href={SITE.base + '/ai-evolution/'} aria-current={isSeries ? 'page' : undefined}>从对话到协作</a>
      <a class="nav-text" href={SITE.base + '/about/'} aria-current={isAbout ? 'page' : undefined}>关于</a>
      <a class="nav-ext" href={SITE.personalSite}>个人主页 ↗</a>
      <a class="nav-ext" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      {!isSeries && !isEssays && (
        <a class="nav-cta" href={SITE.base + '/ai-evolution/overview/'}>开始阅读 <span aria-hidden="true">→</span></a>
      )}
    </nav>
  </div>
</header>