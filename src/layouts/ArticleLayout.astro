---
import BaseLayout from './BaseLayout.astro';
import ChapterNav from '../components/ChapterNav.astro';
import Toc from '../components/Toc.astro';
import { SITE } from '../consts';
import { BLOG_UI, basePath, type Lang } from '../i18n';
import {
  articleUrl,
  minutesOf,
  seriesUrl,
  type ArticleEntry,
  type SeriesEntry,
} from '../lib/articles';

interface Props {
  entry: ArticleEntry;
  series: SeriesEntry;
  /** 系列内的全部文章（阅读顺序），章节型系列用于侧边目录 */
  articles: ArticleEntry[];
  headings: { depth: number; slug: string; text: string }[];
  /** 在系列内的序号，从 1 开始 */
  number: number;
  lang: Lang;
  prev?: ArticleEntry;
  next?: ArticleEntry;
}

const { entry, series, articles, headings, number, lang, prev, next } = Astro.props;
const { data } = entry;
const t = BLOG_UI[lang];
const meta = series.data[lang];
const base = basePath(lang);
const isEssay = series.data.kind === 'essays';
const canonical = new URL(articleUrl(entry), Astro.site).toString();
const pad = (n: number) => String(n).padStart(2, '0');
const ogImage = isEssay ? SITE.base + (data.cover ?? '/og-agentic-coding.png') : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: t.htmlLang,
  datePublished: data.date,
  dateModified: data.updated ?? data.date,
  author: {
    '@type': 'Person',
    name: SITE.author,
    alternateName: SITE.authorEn,
    url: SITE.personalSite,
  },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: canonical,
  isPartOf: isEssay
    ? {
        '@type': 'Blog',
        name: SITE.name + ' · ' + t.nav.home,
        url: new URL(base + '/', Astro.site).toString(),
      }
    : {
        '@type': 'Book',
        name: meta.title + (meta.subtitle ? (lang === 'en' ? ': ' : '：') + meta.subtitle : ''),
        url: new URL(seriesUrl(series.id, lang), Astro.site).toString(),
      },
};

// 上一篇 / 下一篇：章节用“上一章 / 下一章”，单篇用“上一篇 / 下一篇”；到头时指向系列或全部写作
const prevCard = prev
  ? {
      href: articleUrl(prev),
      label: isEssay ? t.article.prevEssay : t.article.prevChapter(pad(number - 1)),
      title: prev.data.title,
    }
  : isEssay
    ? { href: base + '/', label: t.article.back, title: t.article.backToCollection }
    : { href: seriesUrl(series.id, lang), label: t.article.backToSeries, title: meta.title };
const nextCard = next
  ? {
      href: articleUrl(next),
      label: isEssay ? t.article.nextEssay : t.article.nextChapter(pad(number + 1)),
      title: next.data.title,
    }
  : isEssay
    ? { href: seriesUrl(series.id, lang), label: t.article.more, title: t.article.allEssays }
    : { href: base + '/', label: t.article.finished, title: t.article.backToCollection };
---

<BaseLayout title={data.title} description={data.description} type="article" lang={lang} image={ogImage} structuredData={structuredData}>
  <div class="progress" aria-hidden="true"></div>

  <div class={'shell article-grid' + (isEssay ? ' essay-grid' : '')}>
    {!isEssay && <ChapterNav series={series} articles={articles} currentId={entry.id} lang={lang} />}

    <div class="article-body">
      <header class="article-hero">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={base + '/'}>{t.article.crumbsHome}</a>
          <span class="sep">/</span>
          {isEssay ? (
            <a href={seriesUrl(series.id, lang)}>{t.nav.essays}</a>
          ) : (
            <>
              <a href={seriesUrl(series.id, lang)}>{meta.title}</a>
              <span class="sep">/</span>
              <span>{t.article.chapter(pad(number))}</span>
            </>
          )}
        </nav>

        {!isEssay && data.tags.includes('速览') && (
          <span class="tag tag-hot" style="margin-bottom:14px;display:inline-block">{t.article.quickTag}</span>
        )}

        <h1>{data.title}</h1>
        <p class="article-sub">{data.subtitle}</p>

        <div class="article-meta">
          <span>{data.date.replaceAll('-', '.')}</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{t.article.minutes(minutesOf(entry))}</span>
          {data.updated && (
            <>
              <span class="dot" aria-hidden="true"></span>
              <span>{t.article.updatedOn(data.updated.replaceAll('-', '.'))}</span>
            </>
          )}
        </div>
      </header>

      {!isEssay && (
        <details class="mobile-toc">
          <summary>{t.article.chapterToc(pad(number))}</summary>
          <div class="mobile-nav">
            <ChapterNav series={series} articles={articles} currentId={entry.id} lang={lang} />
          </div>
        </details>
      )}

      <article class="prose">
        <slot />
      </article>

      <div class="article-end">
        <span class="article-end-label">{t.article.continueReading}</span>
        <div class="prev-next">
          <a class="pn-card" href={prevCard.href}>
            <small>{prevCard.label}</small>
            <strong>{prevCard.title}</strong>
          </a>
          <a class="pn-card next" href={nextCard.href}>
            <small>{nextCard.label}</small>
            <strong>{nextCard.title}</strong>
          </a>
        </div>

        <div class="author-card">
          <span class="seal" aria-hidden="true">AS</span>
          <p>
            <strong>{SITE.author}</strong>
            {t.article.bio}
            <a href={SITE.personalSite} style="color:var(--accent-2);text-decoration:underline;text-underline-offset:3px">{t.article.bioLink}</a>
          </p>
        </div>

        <p class="article-license">
          {t.article.license}
        </p>
      </div>
    </div>

    <Toc headings={headings} lang={lang} />
  </div>

  <script is:inline>
    (() => {
      const bar = document.querySelector('.progress');
      if (!bar) return;
      let ticking = false;
      const update = () => {
        const root = document.documentElement;
        const max = root.scrollHeight - root.clientHeight;
        bar.style.width = (max > 0 ? (root.scrollTop / max) * 100 : 0) + '%';
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });
      update();
    })();
  </script>

  <script is:inline>
    (() => {
      const links = Array.from(document.querySelectorAll('.toc a'));
      if (!links.length) return;
      const targets = links
        .map((link) => {
          const href = link.getAttribute('href') || '';
          const id = decodeURIComponent(href.replace('#', ''));
          return { link, target: document.getElementById(id) };
        })
        .filter((item) => item.target);
      if (!targets.length) return;

      const setActive = (active) => {
        links.forEach((link) => link.classList.toggle('active', link === active));
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length) {
            const match = targets.find((item) => item.target === visible[0].target);
            if (match) setActive(match.link);
          }
        },
        { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
      );

      targets.forEach((item) => observer.observe(item.target));
    })();
  </script>
</BaseLayout>
