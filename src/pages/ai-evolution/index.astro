---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, SERIES } from '../../consts';

const chapters = (await getCollection('articles'))
  .filter((article) => article.data.lang !== 'en' && article.data.series === SERIES.slug)
  .sort((a, b) => a.data.order - b.data.order);
const totalMinutes = chapters.reduce((sum, chapter) => sum + chapter.data.readingTime, 0);

const groups: { part: string; items: typeof chapters }[] = [];
for (const chapter of chapters) {
  const last = groups[groups.length - 1];
  if (!last || last.part !== chapter.data.part) {
    groups.push({ part: chapter.data.part, items: [chapter] });
  } else {
    last.items.push(chapter);
  }
}

const byId = Object.fromEntries(chapters.map((chapter) => [chapter.id.split('/').pop(), chapter]));
const paths = [
  {
    title: '快速概览',
    desc: '只有半小时：先拿到全景和心智模型，知道三年里发生了什么。',
    items: ['overview', 'restaurant-analogy'],
  },
  {
    title: '按时间线走',
    desc: '一年一章，把模型、产品与协议放回它们出现的时刻。',
    items: ['overview', 'year-2022', 'year-2023', 'year-2024', 'year-2025', 'year-2026', 'outlook'],
  },
  {
    title: '工程师视角',
    desc: '上下文、Prompt、MCP、Skills 四条技术主线，加上推理层与企业落地。',
    items: [
      'overview',
      'context-revolution',
      'prompt-engineering',
      'mcp',
      'agent-skills',
      'new-paradigm',
      'enterprise-case',
      'outlook',
    ],
  },
];

const pathMinutes = (items: string[]) =>
  items.reduce((sum, id) => sum + (byId[id]?.data.readingTime ?? 0), 0);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: SERIES.title + '：' + SERIES.subtitle,
  description: SERIES.description,
  author: {
    '@type': 'Person',
    name: SITE.author,
    alternateName: SITE.authorEn,
    url: SITE.personalSite,
  },
  datePublished: '2026-01-27',
  dateModified: '2026-02-24',
  inLanguage: 'zh-CN',
  bookFormat: 'https://schema.org/EBook',
  url: new URL(SITE.base + '/ai-evolution/', Astro.site).toString(),
  image: new URL(SITE.base + '/og.png', Astro.site).toString(),
};
---

<BaseLayout title={SERIES.title} description={SERIES.description} structuredData={structuredData}>
  <div class="shell series-crumb"><a href={SITE.base + '/'}>文章集</a><span class="sep">/</span><span>{SERIES.title}</span></div>

  <section class="shell hero">
    <div class="hero-copy">
      <p class="kicker">Research note · {SERIES.start} — {SERIES.end}</p>
      <h1 class="display">从对话<br /><span class="accent">到协作</span></h1>
      <p class="hero-sub">AI 大模型三年演进全记录</p>
      <p class="hero-desc">
        三年，上下文放大 500 倍，交互从「写提示词」变成「说目标」，AI 从工具变成同事。
        这份报告把模型、协议与产品放回同一条时间线，解释每一次跃迁解决了什么，又留下了什么。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={SITE.base + '/ai-evolution/overview/'}>开始阅读 <span aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#catalog">查看目录</a>
      </div>
      <p class="hero-note">
        <span>{SERIES.chapterCount} 章</span>
        <span>约 {SERIES.words}字</span>
        <span>{SERIES.sources} 份参考资料</span>
        <span>写于 {SERIES.written}</span>
      </p>
    </div>

    <div class="hero-visual">
      <figure class="cover-card">
        <img
          src={SITE.base + SERIES.cover}
          alt="AI 能力演进：从 2022 年对话 AI 到 2026 年协作 AI"
          width="1408"
          height="768"
          fetchpriority="high"
        />
        <figcaption>
          <span>Fig. 01 / AI capability</span>
          <span>2022 → 2026</span>
        </figcaption>
      </figure>
      <div class="float-stat" aria-hidden="true">
        <strong>500×</strong>
        <span>context growth</span>
      </div>
      <div class="stamp" aria-hidden="true">三年</div>
    </div>
  </section>

  <div class="shell">
    <dl class="meta-strip">
      <div>
        <dt>Author</dt>
        <dd>{SITE.author}</dd>
      </div>
      <div>
        <dt>Chapters</dt>
        <dd>{SERIES.chapterCount} 章 · 约 {totalMinutes} 分钟</dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd>{SERIES.start} — {SERIES.end}</dd>
      </div>
      <div>
        <dt>Written</dt>
        <dd>{SERIES.written}</dd>
      </div>
    </dl>
  </div>

  <section class="shell section" aria-labelledby="tldr-title">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">01</span>
        <h2 class="section-title" id="tldr-title">三句话读完</h2>
      </div>
      <span class="section-note">The short version</span>
    </div>
    <div class="tldr-grid">
      <div class="tldr-item">
        <span class="num">01 / 能力</span>
        <p><strong>能力在跃迁，瓶颈也在转移。</strong>上下文、推理、工具、协作依次成为主战场，每一次突破都会暴露下一层约束。</p>
      </div>
      <div class="tldr-item">
        <span class="num">02 / 架构</span>
        <p><strong>MCP 与 Skills 不是替代关系。</strong>一个解决「能连什么」，一个解决「知道怎么做」。真正的 Agent 架构，两者都要。</p>
      </div>
      <div class="tldr-item">
        <span class="num">03 / 差距</span>
        <p><strong>真正的差距在推理层。</strong>同样的模型，不同的调度、约束与领域知识，产出可以差一个量级。</p>
      </div>
    </div>
  </section>

  <section class="shell section" id="paths" aria-labelledby="paths-title">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">02</span>
        <h2 class="section-title" id="paths-title">选一条阅读路径</h2>
      </div>
      <span class="section-note">全书 {totalMinutes} 分钟</span>
    </div>
    <div class="paths-grid">
      {paths.map((path) => (
        <div class="path-card">
          <div class="path-time">{path.items.length}<small>章</small></div>
          <h3>{path.title}</h3>
          <p>{path.desc}</p>
          <ul class="path-list">
            {path.items.map((id) => (
              <li><a href={SITE.base + '/ai-evolution/' + id + '/'}>{byId[id]?.data.title ?? id}</a></li>
            ))}
          </ul>
          <span class="path-meta">约 {pathMinutes(path.items)} 分钟</span>
        </div>
      ))}
    </div>
  </section>

  <section class="shell section" id="catalog" aria-labelledby="catalog-title">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">03</span>
        <h2 class="section-title" id="catalog-title">目录</h2>
      </div>
      <span class="section-note">{SERIES.chapterCount} chapters · {SERIES.words}字</span>
    </div>

    <div class="catalog">
      {groups.map((group) => (
        <div class="catalog-part">
          <div class="part-head">
            <h3 class="part-name">{group.part} <span>{String(group.items[0].data.num).padStart(2, '0')}</span></h3>
            <p class="part-note">{group.items.length} chapters</p>
          </div>
          <div class="chapter-list">
            {group.items.map((chapter) => (
              <a class="chapter-row" href={SITE.base + '/ai-evolution/' + chapter.id.split('/').pop() + '/'}>
                <span class="row-num">{String(chapter.data.num).padStart(2, '0')}</span>
                <span class="row-main">
                  <span class="row-title">{chapter.data.title}</span>
                  <span class="row-desc">{chapter.data.description}</span>
                </span>
                <span class="row-tags">
                  {chapter.data.tags.map((tag) => (
                    <span class={'tag' + (tag === '深度' ? ' tag-hot' : '')}>{tag}</span>
                  ))}
                </span>
                <span class="row-time">{chapter.data.readingTime} min</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="stats-band" aria-label="报告数据">
    <div class="shell stats-inner">
      <div class="stat">
        <strong>3<em>年</em></strong>
        <span>2022.11 — 2026.01</span>
      </div>
      <div class="stat">
        <strong>500<em>×</em></strong>
        <span>上下文窗口增长</span>
      </div>
      <div class="stat">
        <strong>{SERIES.chapterCount}<em>章</em></strong>
        <span>约 {SERIES.words}字 · {totalMinutes} 分钟</span>
      </div>
      <div class="stat">
        <strong>{SERIES.sources}<em>份</em></strong>
        <span>官方公告与公开资料</span>
      </div>
    </div>
  </section>

  <section class="shell section" aria-labelledby="about-title">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">04</span>
        <h2 class="section-title" id="about-title">关于这个系列</h2>
      </div>
      <a class="section-note" href={SITE.base + '/about/'}>方法论与更新日志 →</a>
    </div>
    <div class="about-grid">
      <div class="about-mark" aria-hidden="true">
        <span class="monogram">AS</span>
        <span class="mark-label">ALLEN SHAO</span>
      </div>
      <div class="about-copy">
        <p>
          这是文章集的第一个系列，一份写给工程师的 AI 演进笔记。它不追求覆盖每一款模型，而是想回答三个问题：
          为什么出现这项技术，它解决了什么问题，又留下了什么新问题。
        </p>
        <p>
          写作以 Claude / Anthropic 生态为主要观察窗口，同时覆盖 OpenAI、Google 与 DeepSeek 的关键进展；
          企业实践部分来自真实平台建设，已做脱敏处理，只保留可迁移的方法。
        </p>
        <p>
          文中观点为个人观察，不代表任职机构。欢迎指出事实错误，或补充你的一线经验。
        </p>
        <div class="about-links">
          <a href={SITE.personalSite}>个人主页 ↗</a>
          <a href={'mailto:' + SITE.email}>Email</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={SITE.base + '/rss.xml'}>RSS</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>