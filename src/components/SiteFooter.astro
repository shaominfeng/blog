---
import { SITE } from '../consts';
import { BLOG_UI, basePath, type Lang } from '../i18n';
import { primarySeries } from '../lib/articles';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = BLOG_UI[lang];
const base = basePath(lang);

const primary = await primarySeries();
const primaryKey = primary?.id ?? 'ai-evolution';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="seal" aria-hidden="true">AS</span>
        <div>
          <strong>{SITE.name} · {t.nav.home}</strong>
          <span>{t.footer.tagline}</span>
        </div>
      </div>
      <div class="footer-links">
        <a href={base + '/'}>{t.footer.home}</a>
        <a href={base + '/' + primaryKey + '/'}>{t.footer.series}</a>
        <a href={base + '/about/'}>{t.footer.about}</a>
        <a href={SITE.base + '/rss.xml'}>RSS</a>
        <a href={SITE.personalSite}>{t.footer.personal}</a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 {SITE.name}</span>
      <span>{t.footer.license}</span>
      <span>{t.footer.built}</span>
    </div>
  </div>
</footer>
