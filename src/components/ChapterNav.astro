---
import type { CollectionEntry } from 'astro:content';
import { BLOG_UI, SERIES_I18N, basePath, type Lang } from '../i18n';
import { slugOf } from '../lib/articles';

interface Props {
  articles: CollectionEntry<'articles'>[];
  currentId?: string;
  lang?: Lang;
}

const { articles, currentId, lang = 'zh' } = Astro.props;
const t = BLOG_UI[lang];
const series = SERIES_I18N[lang];
const base = basePath(lang);
const sorted = [...articles].sort((a, b) => a.data.order - b.data.order);

const groups: { part: string; items: CollectionEntry<'articles'>[] }[] = [];
for (const article of sorted) {
  const last = groups[groups.length - 1];
  if (!last || last.part !== article.data.part) {
    groups.push({ part: article.data.part, items: [article] });
  } else {
    last.items.push(article);
  }
}
---

<nav class="side-nav" aria-label={t.side.chapterNavLabel}>
  <a class="side-back" href={base + '/'}>{t.side.back}</a>
  <a class="side-brand" href={base + '/ai-evolution/'}>
    {series.title}
    <small>{t.side.chapterCount}</small>
  </a>
  {groups.map((group) => (
    <div class="side-part">
      <span class="side-part-label">{series.parts[group.part as keyof typeof series.parts] ?? group.part} / {String(group.items.length).padStart(2, '0')}</span>
      {group.items.map((article) => (
        <a
          href={base + '/ai-evolution/' + slugOf(article) + '/'}
          class={article.id === currentId ? 'active' : undefined}
          aria-current={article.id === currentId ? 'page' : undefined}
        >
          <span class="side-num">{String(article.data.num).padStart(2, '0')}</span>
          {article.data.title}
        </a>
      ))}
    </div>
  ))}
</nav>
