---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

const essays = (await getCollection('articles'))
  .filter((article) => article.data.lang !== 'en' && article.data.series === 'essays')
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '单篇长文 · ' + SITE.name,
  description: '不进入连载的单篇技术写作：工作流、架构复盘与工程实践。',
  url: new URL(SITE.base + '/essays/', Astro.site).toString(),
  author: { '@type': 'Person', name: SITE.author, url: SITE.personalSite },
};
---

<BaseLayout title="单篇长文" description="不进入连载的单篇技术写作：工作流、架构复盘与工程实践。" structuredData={structuredData}>
  <section class="shell blog-hero">
    <p class="label">Essays / {essays.length}</p>
    <h1>单篇</h1>
    <p class="blog-intro">
      不进入连载的独立长文。一次讲透一个问题：一条真实的工作流、一个架构判断，或一次工程复盘。
    </p>
    <div class="blog-meta">
      <span>{essays.length} 篇</span>
      <span>{essays.reduce((sum, essay) => sum + essay.data.readingTime, 0)} 分钟</span>
      <a href={SITE.base + '/'}>← 文章集</a>
    </div>
  </section>

  <section class="shell blog-section">
    <div class="post-list">
      {essays.map((essay, index) => (
        <a class="post-row" href={SITE.base + '/essays/' + essay.id.split('/').pop() + '/'}>
          <span class="pr-num">{String(index + 1).padStart(2, '0')}</span>
          <span class="pr-main">
            <span class="pr-title">{essay.data.title}</span>
            <span class="pr-desc">{essay.data.description}</span>
          </span>
          <span class="pr-meta">
            <span>{essay.data.date?.replaceAll('-', '.')}</span>
            <span>{essay.data.readingTime} min</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell blog-about">
    <div class="about-grid">
      <div class="about-copy">
        <p class="about-statement">下一篇，正在写。</p>
        <p>
          单篇不追求连载的完整结构，只追求把一件事讲透。如果你有想看的主题，欢迎来信。
        </p>
        <div class="contact-line">
          <a href={'mailto:' + SITE.email}>Email</a>
          <a href={SITE.personalSite}>个人主页 ↗</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="about-mark" aria-hidden="true">
        <span class="monogram">AS</span>
        <span class="mark-label">ESSAYS · 2026</span>
      </div>
    </div>
  </section>
</BaseLayout>
