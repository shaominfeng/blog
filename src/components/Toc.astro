---
import { BLOG_UI, type Lang } from '../i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang?: Lang;
}

const { headings, lang = 'zh' } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 2 && (
  <aside class="toc" aria-label={BLOG_UI[lang].tocLabel}>
    <span class="toc-label">On this page</span>
    <ul>
      {items.map((heading) => (
        <li class={'depth-' + heading.depth}>
          <a href={'#' + heading.slug}>{heading.text.replace(/\s*#\s*$/, '')}</a>
        </li>
      ))}
    </ul>
  </aside>
)}
