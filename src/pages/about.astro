---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LICENSE, SITE } from '../consts';
import { allSeries, byOrder, inSeries, wanWords } from '../lib/articles';

const lang = 'zh' as const;
const [seriesList, all] = await Promise.all([allSeries(), getCollection('articles')]);
const primary = seriesList.find((entry) => entry.data.kind === 'chapters');
const chapters = primary ? byOrder(inSeries(all, primary.id, lang)) : [];
const essays = all.filter((entry) => entry.id.startsWith(lang + '/') && entry.id.split('/')[1] !== primary?.id);
const words = wanWords([...chapters, ...essays]);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: '关于 Allen Shao 的文章集',
  description: '这个文章集的写作方法、数据边界、更新日志与授权说明。',
  url: new URL(SITE.base + '/about/', Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
    alternateName: SITE.authorEn,
    url: SITE.personalSite,
  },
};
---

<BaseLayout title="关于这个文章集" description="这个文章集的写作方法、数据边界、更新日志与授权说明。" structuredData={structuredData}>
  <div class="shell page-hero">
    <p class="label">About / Methodology</p>
    <h1>关于这个文章集</h1>
    <p>
      一个工程师的写作空间：以时间线和技术问题为线索，把做过的事、读到的信息和踩过的坑写清楚。
      这里是它的写作方法、数据边界与更新记录。
    </p>
  </div>

  <div class="shell about-page-grid">
    <aside class="about-side">
      <ul class="info-list">
        <li><dt>作者</dt><dd>{SITE.author}</dd></li>
        <li><dt>结构</dt><dd>{seriesList.length} 个系列 + {essays.length} 篇单篇</dd></li>
        <li><dt>章节</dt><dd>{chapters.length} 章</dd></li>
        <li><dt>时间跨度</dt><dd>{primary?.data.start} — {primary?.data.end}</dd></li>
        <li><dt>篇幅</dt><dd>约 {words} 万字</dd></li>
        <li><dt>最后更新</dt><dd>2026.10.26</dd></li>
        <li><dt>授权</dt><dd>{LICENSE}</dd></li>
      </ul>
    </aside>

    <div class="about-prose">
      <h2>为什么写</h2>
      <p>
        2022 年 11 月 ChatGPT 发布时，大多数人看到的是「会聊天的 AI」；三年后，AI 已经在写代码、跑流程、做研究，
        甚至开始以「数字同事」的身份进入工作流。变化太快，讨论很容易变成参数对比和产品站队。
      </p>
      <p>
        这个文章集想做的，是把技术放回它出现的那一刻：它当时解决了什么具体问题？为什么是这个方案？
        代价是什么？下一个瓶颈又在哪里？当这些线索连起来，趋势就不再是新闻标题，而是一条可以理解的因果链。
      </p>

      <h2>怎么写</h2>
      <ul>
        <li><strong>时间线为骨架。</strong>以官方发布、论文与产品更新为锚点，先确认「什么时候发生了什么」。</li>
        <li><strong>问题为线索。</strong>每一项技术都回答「它替代了什么旧方案，又制造了什么新问题」。</li>
        <li><strong>多角色视角。</strong>同一项技术，对用户、应用开发者、产品经理和模型开发者的重要性并不相同。</li>
        <li><strong>实践校验。</strong>用企业平台的真实落地记录，检查哪些判断只在 PPT 里成立。</li>
      </ul>

      <h2>观察窗口与边界</h2>
      <p>
        目前的主线《从对话到协作》以 Claude / Anthropic 生态为主要观察窗口，原因是团队在日常开发中使用 Claude Code 最深，
        对 Agent 编程的体感最完整；同时覆盖 OpenAI（GPT-5、Codex）、Google（Gemini 3）与 DeepSeek（R1）的关键进展。
        这意味着部分章节的深度并不对称，读者应结合自己的工具栈对照阅读。
      </p>
      <p>
        企业实践章节涉及内部平台，已隐去公司名称、产品名称与具体金额，只保留可迁移的方法与里程碑。
        成本类文章里的用量与费率来自个人环境的实测账单，第三方模型部分按公开挂牌价折算，口径与偏差写在正文的「数据边界」一节。
        所有观点为个人观察，不代表任职机构。若发现事实错误，欢迎通过邮件指出。
      </p>

      <h2>接下来</h2>
      <p>
        这个文章集会持续更新：除了《从对话到协作》，还会加入单篇的技术笔记、架构复盘和工具实践。
        下一个系列正在准备中。
      </p>

      <h2>更新日志</h2>
      <ul class="update-list">
        <li><time>2026.10.26</time>新增单篇《AI 编码成本优化：别只盯单价，盯单任务成本》，把三个月的用量账本与成本公式放在一起。</li>
        <li><time>2026.10.25</time>序章去掉与后续章节重复的内容，重写为总纲；补齐 MCP 与 Prompt 工程两章；全书参考资料集中到本页。</li>
        <li><time>2026.10.23</time>文章集上线，从单篇报告迁移为可扩展的文章结构。</li>
        <li><time>2026.06.26</time>新增单篇《工程师 Agentic Coding 的一天》，记录一天真实的 AI 工作流。</li>
        <li><time>2026.02.24</time>《从对话到协作》模块化重构，新增餐厅类比导读与双轨对照。</li>
        <li><time>2026.01.27</time>初稿完成，覆盖 2022.11—2026.01 的时间线与技术演进。</li>
      </ul>

      <h2>参考资料</h2>
      <p class="ref-note">
        《从对话到协作》全书引用的公开资料，共 17 条，按主题分组。括号内为原始发布时间。
      </p>

