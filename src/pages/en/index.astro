---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import {
  allSeries,
  articleUrl,
  byDateDesc,
  byOrder,
  inSeries,
  partLabel,
  seriesUrl,
  totalMinutes,
  wordTotal,
} from '../../lib/articles';

const lang = 'en' as const;
const [seriesList, all] = await Promise.all([allSeries(), getCollection('articles')]);

const primary = seriesList.find((entry) => entry.data.kind === 'chapters');
const essaysMeta = seriesList.find((entry) => entry.data.kind === 'essays');

const chapters = primary ? byOrder(inSeries(all, primary.id, lang)) : [];
const essays = essaysMeta ? byDateDesc(inSeries(all, essaysMeta.id, lang)) : [];

const primaryMeta = primary?.data.en;
const seriesMinutes = totalMinutes(chapters);
const words = wordTotal([...chapters, ...essays]);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name + ' · Writing',
  description:
    'Essays on large language models, agent architecture, cloud security and shipping AI in the enterprise.',
  url: new URL(SITE.base + '/en/', Astro.site).toString(),
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: SITE.author,
    alternateName: SITE.authorEn,
    url: SITE.personalSite,
  },
  blogPost: [
    ...chapters.map((article) => ({
      '@type': 'BlogPosting',
      headline: article.data.title,
      url: new URL(articleUrl(article), Astro.site).toString(),
    })),
    ...essays.map((essay) => ({
      '@type': 'BlogPosting',
      headline: essay.data.title,
      url: new URL(articleUrl(essay), Astro.site).toString(),
    })),
  ],
};
---

<BaseLayout
  title="Writing"
  description="Essays on large language models, agent architecture, cloud security and shipping AI in the enterprise."
  lang={lang}
  structuredData={structuredData}
>
  <section class="shell blog-hero">
    <p class="label">Writing / 2026</p>
    <h1>Writing</h1>
    <p class="blog-intro">
      Writing things down clearly is how I check whether I actually understand them.
      Long-form pieces on how the technology works, the architectural calls behind it,
      and what survives contact with a real enterprise.
    </p>
    <div class="blog-meta">
      <span>{seriesList.length} series</span>
      <span>{chapters.length} chapters</span>
      <span>{essays.length} essays</span>
      <span>{totalMinutes([...chapters, ...essays])} min read</span>
      <a href={SITE.base + '/rss.xml'}>RSS</a>
    </div>
  </section>

  <section class="shell blog-section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">01</span>
        <h2 class="section-title">Essays</h2>
      </div>
      <span class="section-note">{essays.length} standalone</span>
    </div>

    {essays.map((essay, index) => (
      <a class="essay-feature" href={articleUrl(essay)}>
        <div class="ef-copy">
          <span class="project-index">Essay {String(index + 1).padStart(2, '0')} · {essay.data.date?.replaceAll('-', '.')} · {essay.data.readingTime} min</span>
          <h3>{essay.data.title}</h3>
          <p class="sf-sub">{essay.data.subtitle}</p>
          <p class="sf-desc">{essay.data.description}</p>
          <div class="sf-metrics">
            {essay.data.metrics.map((metric) => (
              <span><b>{metric.value}</b>{metric.label ? ' ' + metric.label : ''}</span>
            ))}
          </div>
          <span class="text-link">Read →</span>
        </div>
        <div class="ef-panel" aria-hidden="true">
          <span class="ef-time">{essay.data.panel?.time}</span>
          <span class="ef-label" set:html={essay.data.panel?.label} />
          <span class="ef-rule"></span>
          <span class="ef-meta">{essay.data.panel?.meta}</span>
        </div>
      </a>
    ))}
  </section>

  {primary && primaryMeta && (
    <section class="shell blog-section">
      <div class="section-head">
        <div class="section-head-left">
          <span class="section-index">02</span>
          <h2 class="section-title">Series</h2>
        </div>
        <span class="section-note">{String(seriesList.filter((entry) => entry.data.kind === 'chapters').length).padStart(2, '0')} series</span>
      </div>

      <a class="series-feature" href={seriesUrl(primary.id, lang)}>
        <div class="sf-copy">
          <span class="project-index">{primaryMeta.label} · {primary.data.start}—{primary.data.end} · complete</span>
          <h3>{primaryMeta.title}</h3>
          <p class="sf-sub">{primaryMeta.subtitle}</p>
          <p class="sf-desc">{primaryMeta.description}</p>
          <div class="sf-metrics">
            <span><b>{chapters.length}</b> chapters</span>
            {primary.data.sources && <span><b>{primary.data.sources}</b> sources</span>}
            <span><b>{seriesMinutes}</b> min</span>
          </div>
          <span class="text-link">Open the series →</span>
        </div>
        {primary.data.cover && (
          <div class="sf-cover">
            <img src={SITE.base + primary.data.cover} alt={primaryMeta.title} width="1400" height="764" loading="eager" />
            <span>Updated {primary.data.updated}</span>
          </div>
        )}
      </a>
    </section>
  )}

  <section class="shell blog-section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">03</span>
        <h2 class="section-title">All chapters</h2>
      </div>
      <span class="section-note">{chapters.length} chapters</span>
    </div>

    <div class="post-list">
      {chapters.map((chapter, index) => (
        <a class="post-row" href={articleUrl(chapter)}>
          <span class="pr-num">{String(index + 1).padStart(2, '0')}</span>
          <span class="pr-main">
            <span class="pr-title">{chapter.data.title}</span>
            <span class="pr-desc">{chapter.data.description}</span>
          </span>
          <span class="pr-meta">
            <span>{primary && chapter.data.part ? partLabel(primary, chapter.data.part, lang) : ''}</span>
            <span>{chapter.data.readingTime} min</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell blog-about">
    <div class="about-grid">
      <div class="about-copy">
        <p class="about-statement">The next piece is being written.</p>
        <p>
          This collection keeps growing: alongside the series there are standalone notes,
          architecture post-mortems and tooling write-ups. If there is a topic you want covered,
          email me.
        </p>
        <div class="contact-line">
          <a href={'mailto:' + SITE.email}>Email</a>
          <a href={SITE.personalSite}>Home ↗</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="about-mark" aria-hidden="true">
        <span class="monogram">AS</span>
        <span class="mark-label">WRITING · 2026</span>
      </div>
    </div>
  </section>
</BaseLayout>
