---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import {
  allSeries,
  articleUrl,
  byDateDesc,
  byOrder,
  inSeries,
  partLabel,
  seriesUrl,
  totalMinutes,
  wanWords,
} from '../lib/articles';

const lang = 'zh' as const;
const [seriesList, all] = await Promise.all([allSeries(), getCollection('articles')]);

// 章节型系列（可以多个）+ 单篇集合
const chapterSeries = seriesList.filter((entry) => entry.data.kind === 'chapters');
const essaysMeta = seriesList.find((entry) => entry.data.kind === 'essays');

const seriesBlocks = chapterSeries.map((entry) => ({
  entry,
  meta: entry.data.zh,
  chapters: byOrder(inSeries(all, entry.id, lang)),
}));

const essays = essaysMeta ? byDateDesc(inSeries(all, essaysMeta.id, lang)) : [];
const [leadEssay, ...restEssays] = essays;

const allChapters = seriesBlocks.flatMap((block) => block.chapters);
const words = wanWords([...allChapters, ...essays]);

/** 首页只预览每部系列的前 5 章，完整目录在系列页 */
const PREVIEW = 5;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name + ' · ' + SITE.blogTitle,
  description: SITE.description,
  url: new URL(SITE.base + '/', Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
    alternateName: SITE.authorEn,
    url: SITE.personalSite,
  },
  blogPost: [
    ...allChapters.map((article) => ({
      '@type': 'BlogPosting',
      headline: article.data.title,
      url: new URL(articleUrl(article), Astro.site).toString(),
    })),
    ...essays.map((essay) => ({
      '@type': 'BlogPosting',
      headline: essay.data.title,
      url: new URL(articleUrl(essay), Astro.site).toString(),
    })),
  ],
};
---

<BaseLayout title={SITE.blogTitle} description={SITE.description} structuredData={structuredData}>
  <section class="shell blog-hero">
    <p class="label">Writing / 2026</p>
    <h1>写作</h1>
    <p class="blog-intro">
      把做过的事写清楚，是我检验自己是否真的理解的方式。
      这里放长文：技术原理、架构判断，以及从企业实践里带回来的经验。
    </p>
    <div class="blog-meta">
      <span>{seriesBlocks.length} 个系列</span>
      <span>{allChapters.length} 章</span>
      <span>{essays.length} 篇单篇</span>
      <span>约 {words} 万字</span>
      <a href={SITE.base + '/rss.xml'}>RSS</a>
    </div>
  </section>

  <section class="shell blog-section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">01</span>
        <h2 class="section-title">单篇</h2>
      </div>
      <span class="section-note">按发布时间排列</span>
    </div>

    {leadEssay && (
      <a class="essay-feature" href={articleUrl(leadEssay)}>
        <div class="ef-copy">
          <span class="project-index">Essay 01 · 写于 {leadEssay.data.date?.replaceAll('-', '.')} · {leadEssay.data.readingTime} 分钟</span>
          <h3>{leadEssay.data.title}</h3>
          <p class="sf-sub">{leadEssay.data.subtitle}</p>
          <p class="sf-desc">{leadEssay.data.description}</p>
          <div class="sf-metrics">
            {leadEssay.data.metrics.map((metric) => (
              <span><b>{metric.value}</b>{metric.label ? ' ' + metric.label : ''}</span>
            ))}
          </div>
          <span class="text-link">阅读全文 →</span>
        </div>
        <div class="ef-panel" aria-hidden="true">
          <span class="ef-time">{leadEssay.data.panel?.time}</span>
          <span class="ef-label" set:html={leadEssay.data.panel?.label} />
          <span class="ef-rule"></span>
          <span class="ef-meta">{leadEssay.data.panel?.meta}</span>
        </div>
      </a>
    )}

    {restEssays.length > 0 && (
      <>
        <div class="post-list" style="margin-top: 18px;">
          {restEssays.map((essay, index) => (
            <a class="post-row" href={articleUrl(essay)}>
              <span class="pr-num">{String(index + 2).padStart(2, '0')}</span>
              <span class="pr-main">
                <span class="pr-title">{essay.data.title}</span>
                <span class="pr-desc">{essay.data.description}</span>
              </span>
              <span class="pr-meta">
                <span>{essay.data.date?.replaceAll('-', '.')}</span>
                <span>{essay.data.readingTime} min</span>
              </span>
            </a>
          ))}
        </div>
        <div class="rows-more">
          <a href={SITE.base + '/essays/'}>全部单篇 →</a>
        </div>
      </>
    )}
  </section>

  <section class="shell blog-section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">02</span>
        <h2 class="section-title">系列</h2>
      </div>
      <span class="section-note">长篇连载</span>
    </div>

    {seriesBlocks.map(({ entry, meta, chapters }) => (
      <article class="series-block">
        <a class="series-feature" href={seriesUrl(entry.id, lang)}>
          <div class="sf-copy">
            <span class="project-index">{meta.label} · 写于 {entry.data.written} · 已完结</span>
            <h3>{meta.title}</h3>
            <p class="sf-sub">{meta.subtitle}</p>
            <p class="sf-desc">{meta.description}</p>
            <div class="sf-metrics">
              <span><b>{chapters.length}</b> 章</span>
              <span><b>{wanWords(chapters)}</b> 万字</span>
              {entry.data.sources && <span><b>{entry.data.sources}</b> 份参考</span>}
              <span><b>{totalMinutes(chapters)}</b> 分钟</span>
            </div>
            <span class="text-link">进入系列 →</span>
          </div>
          {entry.data.cover && (
            <div class="sf-cover">
              <img src={SITE.base + entry.data.cover} alt={meta.title} width="1400" height="764" loading="eager" />
              <span>{entry.data.updated} 更新</span>
            </div>
          )}
        </a>

        <div class="catalog">
          <div class="catalog-head">
            <span>目录</span>
            <span>共 {chapters.length} 章 · 约 {totalMinutes(chapters)} 分钟</span>
          </div>
          <div class="post-list">
            {chapters.slice(0, PREVIEW).map((article, index) => (
              <a class="post-row" href={articleUrl(article)}>
                <span class="pr-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="pr-main">
                  <span class="pr-title">{article.data.title}</span>
                  <span class="pr-desc">{article.data.description}</span>
                </span>
                <span class="pr-meta">
                  <span>{article.data.part ? partLabel(entry, article.data.part, lang) : ''}</span>
                  <span>{article.data.readingTime} min</span>
                </span>
              </a>
            ))}
          </div>
          {chapters.length > PREVIEW && (
            <div class="rows-more">
              <a href={seriesUrl(entry.id, lang)}>查看完整目录（{chapters.length} 章）→</a>
            </div>
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="shell blog-about">
    <div class="about-grid">
      <div class="about-copy">
        <p class="about-statement">下一篇文章，正在写。</p>
        <p>
          这里会持续更新：除了《从对话到协作》，还有单篇的技术笔记、架构复盘和工具实践。
          如果你有想看的主题，欢迎来信。
        </p>
        <div class="contact-line">
          <a href={'mailto:' + SITE.email}>Email</a>
          <a href={SITE.personalSite}>个人主页 ↗</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="about-mark" aria-hidden="true">
        <span class="monogram">AS</span>
        <span class="mark-label">WRITING · 2026</span>
      </div>
    </div>
  </section>
</BaseLayout>
