---
import { SITE } from '../consts';
import { BLOG_UI, basePath, type Lang } from '../i18n';
import { primarySeries } from '../lib/articles';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = BLOG_UI[lang];
const base = basePath(lang);

// 页头的“系列”入口指向主系列，标签统一用分类名，与“单篇”保持同级
const primary = await primarySeries();
const primaryKey = primary?.id ?? 'ai-evolution';
const seriesLabel = t.nav.series;

const path = Astro.url.pathname;
const isIndex = path === base + '/' || path === base;
const isEssays = path.startsWith(base + '/essays/');
const isSeries = path.startsWith(base + '/' + primaryKey + '/');
const isAbout = path === base + '/about/' || path === base + '/about';

// 语言切换：保留当前页在另一语言下的等价路径
const inner = path.startsWith(SITE.base + '/en')
  ? path.slice((SITE.base + '/en').length)
  : path.slice(SITE.base.length);
const altPath = (lang === 'en' ? SITE.base : SITE.base + '/en') + (inner || '/');
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base + '/'}>
      <span class="seal" aria-hidden="true">AS</span>
      <span class="brand-copy">
        <strong>{SITE.name} · {t.nav.home}</strong>
        <span>Writing & Notes</span>
      </span>
    </a>

    <nav class="site-nav" aria-label={t.nav.label}>
      <a class="nav-text" href={base + '/'} aria-current={isIndex ? 'page' : undefined}>{t.nav.home}</a>
      <a class="nav-text" href={base + '/essays/'} aria-current={isEssays ? 'page' : undefined}>{t.nav.essays}</a>
      <a class="nav-text" href={base + '/' + primaryKey + '/'} aria-current={isSeries ? 'page' : undefined}>{seriesLabel}</a>
      <a class="nav-text" href={base + '/about/'} aria-current={isAbout ? 'page' : undefined}>{t.nav.about}</a>
      <a
        class="lang-switch"
        href={altPath}
        hreflang={lang === 'en' ? 'zh-CN' : 'en'}
        aria-label={t.nav.switchLabel}
        title={t.nav.switchLabel}>{t.nav.switchText}</a>
      <a class="nav-ext" href={SITE.personalSite}>{t.nav.personal}</a>
      <a class="nav-ext" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      {!isSeries && !isEssays && (
        <a class="nav-cta" href={base + '/' + primaryKey + '/'}>{t.nav.cta} <span aria-hidden="true">→</span></a>
      )}

      {/* ≤460px 时上面的文字导航会全部隐藏，由这个折叠菜单接替，否则手机上无法进入二级页 */}
      <details class="nav-compact">
        <summary aria-label={t.nav.label}>
          <span class="bars" aria-hidden="true"></span>
        </summary>
        <div class="nav-compact-panel">
          <a href={base + '/'}>{t.nav.home}</a>
          <a href={base + '/essays/'}>{t.nav.essays}</a>
          <a href={base + '/' + primaryKey + '/'}>{seriesLabel}</a>
          <a href={base + '/about/'}>{t.nav.about}</a>
          <a class="ext" href={SITE.personalSite}>{t.nav.personal}</a>
          <a class="ext" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </details>
    </nav>
  </div>
</header>
