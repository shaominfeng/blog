---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import EssayLayout from '../../layouts/EssayLayout.astro';

export async function getStaticPaths() {
  const essays = (await getCollection('articles'))
    .filter((article) => article.data.series === 'essays')
    .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));

  return essays.map((entry: CollectionEntry<'articles'>, index: number) => ({
    params: { slug: entry.id.split('/').pop() },
    props: {
      entry,
      prev: essays[index - 1],
      next: essays[index + 1],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const essays = (await getCollection('articles'))
  .filter((article) => article.data.series === 'essays')
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
const { Content, headings } = await render(entry);
---

<EssayLayout entry={entry} headings={headings} essays={essays} prev={prev} next={next}>
  <Content />
</EssayLayout>
