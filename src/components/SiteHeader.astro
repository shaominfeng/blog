---
import { SITE } from '../consts';
import { BLOG_UI, basePath, type Lang } from '../i18n';
import { chapterSeries, seriesEntryUrl } from '../lib/articles';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = BLOG_UI[lang];
const base = basePath(lang);

// “系列”入口：一部连载直达它，多部时指向 /series/ 索引
const seriesHref = await seriesEntryUrl(lang);
const seriesKeys = (await chapterSeries()).map((entry) => entry.id);

const path = Astro.url.pathname;
const isIndex = path === base + '/' || path === base;
const isEssays = path.startsWith(base + '/essays/');
const isSeries =
  path.startsWith(base + '/series/') || seriesKeys.some((key) => path.startsWith(base + '/' + key + '/'));
const isAbout = path === base + '/about/' || path === base + '/about';

// 语言切换：保留当前页在另一语言下的等价路径
const inner = path.startsWith(SITE.base + '/en')
  ? path.slice((SITE.base + '/en').length)
  : path.slice(SITE.base.length);
const altPath = (lang === 'en' ? SITE.base : SITE.base + '/en') + (inner || '/');
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base + '/'}>
      <span class="seal" aria-hidden="true">AS</span>
      <strong>{SITE.name} · {t.nav.home}</strong>
    </a>

    <nav class="site-nav" aria-label={t.nav.label}>
      <a href={base + '/'} aria-current={isIndex ? 'page' : undefined}>{t.nav.home}</a>
      <a href={base + '/essays/'} aria-current={isEssays ? 'page' : undefined}>{t.nav.essays}</a>
      <a href={seriesHref} aria-current={isSeries ? 'page' : undefined}>{t.nav.series}</a>
      <a href={base + '/about/'} aria-current={isAbout ? 'page' : undefined}>{t.nav.about}</a>
      <a
        class="lang-switch"
        href={altPath}
        hreflang={lang === 'en' ? 'zh-CN' : 'en'}
        aria-label={t.nav.switchLabel}
        title={t.nav.switchLabel}>{t.nav.switchText}</a>

      {/* ≤640px 时上面的文字导航隐藏，由这个折叠菜单接替，否则手机上无法进入二级页 */}
      <details class="nav-compact">
        <summary aria-label={t.nav.label}>
          <span class="bars" aria-hidden="true"></span>
        </summary>
        <div class="nav-compact-panel">
          <a href={base + '/'}>{t.nav.home}</a>
          <a href={base + '/essays/'}>{t.nav.essays}</a>
          <a href={seriesHref}>{t.nav.series}</a>
          <a href={base + '/about/'}>{t.nav.about}</a>
        </div>
      </details>
    </nav>
  </div>
</header>
