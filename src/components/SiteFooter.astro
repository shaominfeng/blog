---
import { SITE } from '../consts';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="seal" aria-hidden="true">邵</span>
        <div>
          <strong>从对话到协作</strong>
          <span>AI 大模型三年演进全记录 · 2022.11—2026.01</span>
        </div>
      </div>
      <div class="footer-links">
        <a href={SITE.base + '/'}>首页</a>
        <a href={SITE.base + '/#catalog'}>目录</a>
        <a href={SITE.base + '/about/'}>关于</a>
        <a href={SITE.base + '/rss.xml'}>RSS</a>
        <a href={SITE.personalSite}>个人主页 ↗</a>
        <a href={SITE.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 {SITE.author} · {SITE.authorEn}</span>
      <span>文字以 {SITE.license} 授权 · 转载注明出处</span>
      <span>写于中国 · 用 Astro 构建</span>
    </div>
  </div>
</footer>
