---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import '../styles/blog.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../consts';
import { BLOG_UI, langFromPath } from '../i18n';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  /** 显式指定语言；缺省时按 URL 判断（/blog/en/ 为英文） */
  lang?: 'zh' | 'en';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = SITE.base + '/og.png',
  type = 'website',
  noindex = false,
  lang = langFromPath(Astro.url.pathname),
  structuredData,
} = Astro.props;

const t = BLOG_UI[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const homeLabel = lang === 'en' ? 'Writing' : SITE.blogTitle;
const fullTitle = title === SITE.blogTitle || title === homeLabel ? SITE.name + ' · ' + homeLabel : title + ' · ' + SITE.name;

// 中英文等价路径：/blog/x/ ↔ /blog/en/x/
const path = Astro.url.pathname;
const inner = path.startsWith(SITE.base + '/en')
  ? path.slice((SITE.base + '/en').length)
  : path.slice(SITE.base.length);
const pairPath = (target: 'zh' | 'en') =>
  new URL((target === 'en' ? SITE.base + '/en' : SITE.base) + (inner || '/'), Astro.site).toString();
// 404 等非页面产物不输出 hreflang
const hasTranslation = !noindex && !path.endsWith('.html') && !path.endsWith('.xml');

// 国内搜索引擎验证码（构建时通过环境变量注入，未设置则不输出）
const BAIDU_VERIFY = import.meta.env.PUBLIC_BAIDU_VERIFY || '';
const SO_VERIFY = import.meta.env.PUBLIC_360_VERIFY || '';
const SOGOU_VERIFY = import.meta.env.PUBLIC_SOGOU_VERIFY || '';
const BAIDU_PUSH = import.meta.env.PUBLIC_BAIDU_PUSH === '1';
const BAIDU_PUSH_SNIPPET =
  '(function(){var bp=document.createElement("script");' +
  'bp.src="https://zz.bdstatic.com/linksubmit/push.js";' +
  'var s=document.getElementsByTagName("script")[0];' +
  's.parentNode.insertBefore(bp,s);})();';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {hasTranslation && (
      <>
        <link rel="alternate" hreflang="zh-CN" href={pairPath('zh')} />
        <link rel="alternate" hreflang="en" href={pairPath('en')} />
        <link rel="alternate" hreflang="x-default" href={pairPath('zh')} />
      </>
    )}

    <!-- 国内搜索引擎 / 浏览器适配 -->
    <meta name="applicable-device" content="pc,mobile" />
    <meta name="renderer" content="webkit" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no" />
    {BAIDU_VERIFY && <meta name="baidu-site-verification" content={BAIDU_VERIFY} />}
    {SO_VERIFY && <meta name="360-site-verification" content={SO_VERIFY} />}
    {SOGOU_VERIFY && <meta name="sogou_site_verification" content={SOGOU_VERIFY} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={homeLabel} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={t.ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={SITE.base + '/favicon.svg'} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name + ' · ' + homeLabel} href={SITE.base + '/rss.xml'} />
    <meta name="theme-color" content="#f7f3eb" />
    <meta name="generator" content={Astro.generator} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <SiteHeader lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    {BAIDU_PUSH && <script is:inline set:html={BAIDU_PUSH_SNIPPET} />}
  </body>
</html>
