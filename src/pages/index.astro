---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import {
  allSeries,
  articleUrl,
  byDateDesc,
  byOrder,
  inSeries,
  partLabel,
  seriesUrl,
  totalMinutes,
  wanWords,
} from '../lib/articles';

const lang = 'zh' as const;
const [seriesList, all] = await Promise.all([allSeries(), getCollection('articles')]);

const primary = seriesList.find((entry) => entry.data.kind === 'chapters');
const essaysMeta = seriesList.find((entry) => entry.data.kind === 'essays');

const chapters = primary ? byOrder(inSeries(all, primary.id, lang)) : [];
const essays = essaysMeta ? byDateDesc(inSeries(all, essaysMeta.id, lang)) : [];

const primaryMeta = primary?.data.zh;
const seriesMinutes = totalMinutes(chapters);
const words = wanWords([...chapters, ...essays]);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name + ' · ' + SITE.blogTitle,
  description: SITE.description,
  url: new URL(SITE.base + '/', Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
    alternateName: SITE.authorEn,
    url: SITE.personalSite,
  },
  blogPost: [
    ...chapters.map((article) => ({
      '@type': 'BlogPosting',
      headline: article.data.title,
      url: new URL(articleUrl(article), Astro.site).toString(),
    })),
    ...essays.map((essay) => ({
      '@type': 'BlogPosting',
      headline: essay.data.title,
      url: new URL(articleUrl(essay), Astro.site).toString(),
    })),
  ],
};
---

<BaseLayout title={SITE.blogTitle} description={SITE.description} structuredData={structuredData}>
  <section class="shell blog-hero">
    <p class="label">Writing / 2026</p>
    <h1>文章集</h1>
    <p class="blog-intro">
      把做过的事写清楚，是我检验自己是否真的理解的方式。
      这里放长文：技术原理、架构判断，以及从企业实践里带回来的经验。
    </p>
    <div class="blog-meta">
      <span>{seriesList.length} 个系列</span>
      <span>{chapters.length} 章</span>
      <span>{essays.length} 篇单篇</span>
      <span>约 {words} 万字</span>
      {primary?.data.sources && <span>{primary.data.sources} 份参考</span>}
      <a href={SITE.base + '/rss.xml'}>RSS</a>
    </div>
  </section>

  <section class="shell blog-section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">01</span>
        <h2 class="section-title">单篇</h2>
      </div>
      <span class="section-note">{essays.length} essay</span>
    </div>

    {essays.map((essay, index) => (
      <a class="essay-feature" href={articleUrl(essay)}>
        <div class="ef-copy">
          <span class="project-index">Essay {String(index + 1).padStart(2, '0')} · 写于 {essay.data.date?.replaceAll('-', '.')} · {essay.data.readingTime} 分钟</span>
          <h3>{essay.data.title}</h3>
          <p class="sf-sub">{essay.data.subtitle}</p>
          <p class="sf-desc">{essay.data.description}</p>
          <div class="sf-metrics">
            {essay.data.metrics.map((metric) => (
              <span><b>{metric.value}</b>{metric.label ? ' ' + metric.label : ''}</span>
            ))}
          </div>
          <span class="text-link">阅读全文 →</span>
        </div>
        <div class="ef-panel" aria-hidden="true">
          <span class="ef-time">{essay.data.panel?.time}</span>
          <span class="ef-label" set:html={essay.data.panel?.label} />
          <span class="ef-rule"></span>
          <span class="ef-meta">{essay.data.panel?.meta}</span>
        </div>
      </a>
    ))}
  </section>

  {primary && primaryMeta && (
    <section class="shell blog-section">
      <div class="section-head">
        <div class="section-head-left">
          <span class="section-index">02</span>
          <h2 class="section-title">系列</h2>
        </div>
        <span class="section-note">{String(seriesList.filter((entry) => entry.data.kind === 'chapters').length).padStart(2, '0')} series</span>
      </div>

      <a class="series-feature" href={seriesUrl(primary.id, lang)}>
        <div class="sf-copy">
          <span class="project-index">{primaryMeta.label} · 写于 {primary.data.written} · 已完结</span>
          <h3>{primaryMeta.title}</h3>
          <p class="sf-sub">{primaryMeta.subtitle}</p>
          <p class="sf-desc">{primaryMeta.description}</p>
          <div class="sf-metrics">
            <span><b>{chapters.length}</b> 章</span>
            <span><b>{wanWords(chapters)}</b> 万字</span>
            {primary.data.sources && <span><b>{primary.data.sources}</b> 份参考</span>}
            <span><b>{seriesMinutes}</b> 分钟</span>
          </div>
          <span class="text-link">进入系列 →</span>
        </div>
        {primary.data.cover && (
          <div class="sf-cover">
            <img src={SITE.base + primary.data.cover} alt={primaryMeta.title} width="1400" height="764" loading="eager" />
            <span>{primary.data.updated} 更新</span>
          </div>
        )}
      </a>
    </section>
  )}

  <section class="shell blog-section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">03</span>
        <h2 class="section-title">全部章节</h2>
      </div>
      <span class="section-note">{chapters.length} chapters</span>
    </div>

    <div class="post-list">
      {chapters.map((article, index) => (
        <a class="post-row" href={articleUrl(article)}>
          <span class="pr-num">{String(index + 1).padStart(2, '0')}</span>
          <span class="pr-main">
            <span class="pr-title">{article.data.title}</span>
            <span class="pr-desc">{article.data.description}</span>
          </span>
          <span class="pr-meta">
            <span>{primary && article.data.part ? partLabel(primary, article.data.part, lang) : ''}</span>
            <span>{article.data.readingTime} min</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell blog-about">
    <div class="about-grid">
      <div class="about-copy">
        <p class="about-statement">下一篇文章，正在写。</p>
        <p>
          这个文章集会持续更新：除了《从对话到协作》，还有单篇的技术笔记、架构复盘和工具实践。
          如果你有想看的主题，欢迎来信。
        </p>
        <div class="contact-line">
          <a href={'mailto:' + SITE.email}>Email</a>
          <a href={SITE.personalSite}>个人主页 ↗</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="about-mark" aria-hidden="true">
        <span class="monogram">AS</span>
        <span class="mark-label">WRITING · 2026</span>
      </div>
    </div>
  </section>
</BaseLayout>
