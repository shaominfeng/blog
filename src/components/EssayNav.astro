---
import { BLOG_UI, basePath, type Lang } from '../i18n';
import { articleUrl, byDateDesc, seriesUrl, type ArticleEntry, type SeriesEntry } from '../lib/articles';

interface Props {
  essays: ArticleEntry[];
  currentId?: string;
  lang?: Lang;
  /** 侧栏底部指向主系列的入口，可选 */
  primary?: { series: SeriesEntry; count: number };
}

const { essays, currentId, lang = 'zh', primary } = Astro.props;
const t = BLOG_UI[lang];
const base = basePath(lang);

const sorted = byDateDesc(essays);
---

<nav class="side-nav" aria-label={t.side.essayNavLabel}>
  <a class="side-back" href={base + '/'}>{t.side.back}</a>
  <a class="side-brand" href={base + '/essays/'}>
    {t.side.essays}
    <small>{sorted.length}{t.series.essaysNote}</small>
  </a>
  <div class="side-part">
    <span class="side-part-label">{t.nav.essays} / {String(sorted.length).padStart(2, '0')}</span>
    {sorted.map((essay) => (
      <a
        href={articleUrl(essay)}
        class={essay.id === currentId ? 'active' : undefined}
        aria-current={essay.id === currentId ? 'page' : undefined}
      >
        <span class="side-num">{essay.data.date?.slice(5).replace('-', '.') ?? '—'}</span>
        {essay.data.title}
      </a>
    ))}
  </div>
  {primary && (
    <div class="side-part">
      <span class="side-part-label">{t.side.seriesLabel}</span>
      <a href={seriesUrl(primary.series.id, lang)}>
        <span class="side-num">{primary.count}</span>
        {primary.series.data[lang].title}
      </a>
    </div>
  )}
</nav>
