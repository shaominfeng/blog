---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesLanding from './SeriesLanding.astro';
import EssaySeriesIndex from './EssaySeriesIndex.astro';
import { SITE } from '../consts';
import { BLOG_UI, type Lang } from '../i18n';
import { byDateDesc, byOrder, inSeries, seriesUrl, type SeriesEntry } from '../lib/articles';

interface Props {
  series: SeriesEntry;
  lang: Lang;
}

const { series, lang } = Astro.props;
const meta = series.data[lang];

const all = await getCollection('articles');
const entries = inSeries(all, series.id, lang);
const isEssays = series.data.kind === 'essays';
const chapters = isEssays ? [] : byOrder(entries);
const essays = isEssays ? byDateDesc(entries) : [];

const structuredData = isEssays
  ? {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: meta.title + ' · ' + SITE.name,
      description: meta.description,
      url: new URL(seriesUrl(series.id, lang), Astro.site).toString(),
      inLanguage: BLOG_UI[lang].htmlLang,
      author: { '@type': 'Person', name: SITE.author, url: SITE.personalSite },
    }
  : undefined;
---

<BaseLayout title={meta.title} description={meta.description} lang={lang} structuredData={structuredData}>
  {isEssays
    ? <EssaySeriesIndex series={series} essays={essays} lang={lang} />
    : <SeriesLanding series={series} chapters={chapters} lang={lang} />}
</BaseLayout>
