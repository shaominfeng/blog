---
import ArticlePage from '../../components/ArticlePage.astro';
import { articlePaths } from '../../lib/articles';

export async function getStaticPaths() {
  return articlePaths('zh');
}

const { article, series, list, index, prev, next } = Astro.props;
---

<ArticlePage article={article} series={series} list={list} index={index} prev={prev} next={next} lang="zh" />
