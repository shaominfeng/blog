---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import EssayNav from '../components/EssayNav.astro';
import Toc from '../components/Toc.astro';
import { SITE } from '../consts';
import { BLOG_UI, basePath, type Lang } from '../i18n';

interface Props {
  entry: CollectionEntry<'articles'>;
  headings: { depth: number; slug: string; text: string }[];
  essays: CollectionEntry<'articles'>[];
  prev?: CollectionEntry<'articles'>;
  next?: CollectionEntry<'articles'>;
}

const { entry, headings, essays, prev, next } = Astro.props;
const { data } = entry;
const lang: Lang = data.lang === 'en' ? 'en' : 'zh';
const t = BLOG_UI[lang];
const base = basePath(lang);
const slug = entry.id.split('/').pop();
const canonical = new URL(base + '/essays/' + slug + '/', Astro.site).toString();
const dateLabel = data.date ? data.date.replaceAll('-', '.') : '';
const ogImage = data.cover ? SITE.base + data.cover : SITE.base + '/og-agentic-coding.png';

const sorted = [...essays].sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
const index = sorted.findIndex((essay) => essay.id === entry.id) + 1;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: t.htmlLang,
  datePublished: data.date,
  dateModified: data.updated ?? data.date,
  author: {
    '@type': 'Person',
    name: SITE.author,
    alternateName: SITE.authorEn,
    url: SITE.personalSite,
  },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: canonical,
  isPartOf: {
    '@type': 'Blog',
    name: SITE.name + ' · ' + t.nav.home,
    url: new URL(base + '/', Astro.site).toString(),
  },
};
---

<BaseLayout title={data.title} description={data.description} type="article" lang={lang} image={ogImage} structuredData={structuredData}>
  <div class="progress" aria-hidden="true"></div>

  <div class="shell article-grid">
    <EssayNav essays={essays} currentId={entry.id} lang={lang} />

    <div class="article-body">
      <header class="article-hero">
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={base + '/'}>{t.article.crumbsHome}</a>
          <span class="sep">/</span>
          <a href={base + '/essays/'}>{t.nav.essays}</a>
          <span class="sep">/</span>
          <span>{t.article.essayLabel} {String(index).padStart(2, '0')}</span>
        </nav>

        <span class="tag tag-hot" style="margin-bottom:14px;display:inline-block">{t.article.essayTag}</span>

        <h1>{data.title}</h1>
        <p class="article-sub">{data.subtitle}</p>
        <p class="article-sub" style="font-size:15px;line-height:1.8;color:var(--ink-3)">{data.description}</p>

        <div class="article-meta">
          <span>{SITE.author}</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{t.article.wroteOn(dateLabel)}</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{t.article.minutes(data.readingTime)}</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{data.part}</span>
        </div>
      </header>

      <details class="mobile-toc">
        <summary>{t.article.essayToc}</summary>
        <div class="mobile-nav">
          <EssayNav essays={essays} currentId={entry.id} lang={lang} />
        </div>
      </details>

      <article class="prose">
        <slot />
      </article>

      <div class="article-end">
        <span class="article-end-label">{t.article.continueReading}</span>
        <div class="prev-next">
          {prev ? (
            <a class="pn-card" href={base + '/essays/' + prev.id.split('/').pop() + '/'}>
              <small>{t.article.prevEssay}</small>
              <strong>{prev.data.title}</strong>
            </a>
          ) : (
            <a class="pn-card" href={base + '/'}>
              <small>{t.article.back}</small>
              <strong>{t.article.backToCollection}</strong>
            </a>
          )}
          {next ? (
            <a class="pn-card next" href={base + '/essays/' + next.id.split('/').pop() + '/'}>
              <small>{t.article.nextEssay}</small>
              <strong>{next.data.title}</strong>
            </a>
          ) : (
            <a class="pn-card next" href={base + '/essays/'}>
              <small>{t.article.more}</small>
              <strong>{t.article.allEssays}</strong>
            </a>
          )}
        </div>

        <div class="author-card">
          <span class="seal" aria-hidden="true">AS</span>
          <p>
            <strong>{SITE.author}</strong>
            {t.article.bio}
            <a href={SITE.personalSite} style="color:var(--accent-2);text-decoration:underline;text-underline-offset:3px">{t.article.bioLink}</a>
          </p>
        </div>

        <p class="article-license">
          {t.article.license}
        </p>
      </div>
    </div>

    <Toc headings={headings} lang={lang} />
  </div>

  <script is:inline>
    (() => {
      const bar = document.querySelector('.progress');
      if (!bar) return;
      let ticking = false;
      const update = () => {
        const root = document.documentElement;
        const max = root.scrollHeight - root.clientHeight;
        bar.style.width = (max > 0 ? (root.scrollTop / max) * 100 : 0) + '%';
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });
      update();
    })();
  </script>

  <script is:inline>
    (() => {
      const links = Array.from(document.querySelectorAll('.toc a'));
      if (!links.length) return;
      const targets = links
        .map((link) => {
          const href = link.getAttribute('href') || '';
          const id = decodeURIComponent(href.replace('#', ''));
          return { link, target: document.getElementById(id) };
        })
        .filter((item) => item.target);
      if (!targets.length) return;

      const setActive = (active) => {
        links.forEach((link) => link.classList.toggle('active', link === active));
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length) {
            const match = targets.find((item) => item.target === visible[0].target);
            if (match) setActive(match.link);
          }
        },
        { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
      );

      targets.forEach((item) => observer.observe(item.target));
    })();
  </script>
</BaseLayout>
